{
  "buildCommand": "npm install --include=dev && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    { "source": "/fc", "destination": "/api/family-card" },
    { "source": "/line-webhook", "destination": "/api/line-webhook" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/privacy/:path*", "destination": "/index.html" },
    { "source": "/blind", "destination": "/index.html" },
    { "source": "/blind/:path*", "destination": "/index.html" }
  ]
}
